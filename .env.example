# Token bot dari @BotFather
BOT_TOKEN=123456789:ABC-your-telegram-bot-token

# Kredensial SSH ke server target (tempat service-arlods, main-service, main-ui, bcv-ui berjalan)
SSH_HOST=192.0.2.10
SSH_PORT=22
SSH_USERNAME=deploy
SSH_PASSWORD=change-me

# Direktori di server tempat Makefile (project/p3, base-compose, dll) berada
SERVER_PROJECT_DIR=/opt/apps/main-project

# Chat ID grup/telegram yang boleh pakai bot ini (bisa lebih dari satu, pisahkan koma)
# Cara dapat chat ID grup: tambahkan bot @RawDataBot ke grup, atau cek update via getUpdates
ALLOWED_CHAT_IDS=-1001234567890

# Opsional: batas waktu eksekusi command di server (ms)
COMMAND_TIMEOUT_MS=60000
